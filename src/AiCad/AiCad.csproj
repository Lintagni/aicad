<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Optional project file for Visual Studio or `dotnet build`. The repository
    also builds with build.ps1, which needs neither.

    AutoCAD 2020 hosts .NET Framework 4.7, so the target framework must not be
    raised without checking the AutoCAD release you are loading into.
  -->

  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <AssemblyName>AiCad</AssemblyName>
    <RootNamespace>AiCad</RootNamespace>
    <LangVersion>5</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2020</AcadDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets `dotnet build` target .NET Framework without Visual Studio installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Private=false is essential: these assemblies must never be copied beside
      the plug-in. AutoCAD loads its own copies, and a stale duplicate in the
      output folder causes hard-to-diagnose load failures.
    -->
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
